{
  "name": "ledgerflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock-api": "python3 dev-mock-api/server.py",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node e2e/web-smoke.mjs",
    "test:agent": "node e2e/agent-smoke.mjs",
    "icons": "python3 scripts/build-icons.py",
    "package:web": "python3 scripts/package-web.py",
    "test:pwa": "node e2e/pwa-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.2"
  }
}
